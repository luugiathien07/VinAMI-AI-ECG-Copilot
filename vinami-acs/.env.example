VINAMI_APP_ENVIRONMENT=development
VINAMI_DATABASE_URL=postgresql+psycopg://vinami:vinami@postgres:5432/vinami_acs
VINAMI_REDIS_URL=redis://redis:6379/0
VINAMI_DASHBOARD_API_BASE_URL=http://api:8000
VINAMI_LOG_LEVEL=INFO
VINAMI_IDENTITY_MODE=development
VINAMI_ECG_ARTIFACT_ROOT=/var/lib/vinami/ecg-artifacts
VINAMI_ECG_ARTIFACT_MAX_BYTES=26214400
VINAMI_ECG_PROVIDER=mock
VINAMI_ECG_ALLOW_MOCK_PROVIDER=true
# Optional real ECG model adapter. Keep Docker demo on mock unless the runtime has torch/timm.
# VINAMI_ECG_PROVIDER=torch
# VINAMI_ECG_CHECKPOINT_PATH=/absolute/path/to/VinStroke_ECG_artifacts/models/best_model.pt
# VINAMI_ECG_CHECKPOINT_SHA256=db43e0caedbcc579ea8a495dec1310066016d7ea55ad537e77bb4e5a48fc1837
# VINAMI_ECG_DEVICE=cpu
# Optional lightweight R23A showcase provider generated from best_model.pt.
# VINAMI_ECG_PROVIDER=ptbxl-showcase
# VINAMI_ECG_SHOWCASE_MANIFEST_PATH=/opt/vinstroke-ecg-artifacts/reports/r23a_showcase_predictions.json
# VINAMI_ECG_SHOWCASE_ARTIFACT_ROOT=/opt/vinstroke-ecg-artifacts
# Optional ACS-native 1D-signal STEMI screener (TCN checkpoint, 500 Hz / 5000-sample input).
# Selected explicitly per request as provider "torch-acs-stemi"; see ADR-011.
# VINAMI_ECG_STEMI_CHECKPOINT_PATH=/absolute/path/to/models/acs_tcn.pt
# VINAMI_ECG_STEMI_CHECKPOINT_SHA256=replace-with-sha256sum-of-acs_tcn.pt
VINAMI_ECG_PROVIDER_TIMEOUT_SECONDS=30
VINAMI_ECG_ALLOW_PROVIDER_FALLBACK=false
VINAMI_ECG_FALLBACK_PROVIDER=mock
VINAMI_API_BASE_URL=http://api:8000
VINAMI_WEB_IDENTITY_MODE=development
VINAMI_WEB_DEVELOPMENT_IDENTITY=physician
NEXT_PUBLIC_PRODUCT_NAME=VinAMI ACS Operating System
NEXT_PUBLIC_ORGANIZATION_NAME=VinAMI Clinical Research
NEXT_PUBLIC_ENVIRONMENT=Development
NEXT_PUBLIC_RESEARCH_USE=true
# OIDC production-shaped mode (do not commit credentials or access tokens):
# VINAMI_IDENTITY_MODE=oidc
# VINAMI_OIDC_ISSUER=https://identity.example.invalid
# VINAMI_OIDC_AUDIENCE=vinami-acs-api
# VINAMI_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# VINAMI_OIDC_ALLOWED_ALGORITHMS=RS256
# VINAMI_OIDC_ROLE_CLAIM=roles
# VINAMI_OIDC_PERMISSION_CLAIM=permissions
POSTGRES_DB=vinami_acs
POSTGRES_USER=vinami
POSTGRES_PASSWORD=vinami
